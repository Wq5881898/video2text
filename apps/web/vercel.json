{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "builds": [
    { "src": "api/blob-upload.js", "use": "@vercel/node" },
    { "src": "api/health.py", "use": "@vercel/python" },
    { "src": "api/capabilities.py", "use": "@vercel/python" },
    { "src": "api/transcribe.py", "use": "@vercel/python" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/blob-upload", "dest": "api/blob-upload.js" },
    { "src": "/api/health", "dest": "api/health.py" },
    { "src": "/api/capabilities", "dest": "api/capabilities.py" },
    { "src": "/api/transcribe", "dest": "api/transcribe.py" },
    { "src": "/(.*)", "dest": "public/$1" }
  ]
}
