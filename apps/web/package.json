{
  "name": "video2text-web",
  "private": true,
  "version": "0.1.0",
  "description": "Web surface for video2text",
  "scripts": {
    "dev": "python dev_server.py",
    "build": "esbuild public/mobile.js --bundle --format=esm --platform=browser --target=safari15 --outfile=public/mobile.bundle.js",
    "deploy": "vercel --prod",
    "test:cloud": "node cloud_e2e_test.js"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "1.1.0",
    "@ffprobe-installer/ffprobe": "2.1.2",
    "@vercel/blob": "^2.6.1",
    "@vercel/functions": "^3.7.6"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
