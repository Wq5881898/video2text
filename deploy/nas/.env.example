# Public DNS-only hostname. Do not enable the Cloudflare orange-cloud proxy.
VIDEO2TEXT_PUBLIC_HOST=upload.151077.xyz
VIDEO2TEXT_PUBLIC_ORIGIN=https://upload.151077.xyz
VIDEO2TEXT_WEB_HOST=stt.151077.xyz
VIDEO2TEXT_WEB_ORIGIN=https://stt.151077.xyz

# Caddy protects the standalone web/control plane. Generate the hash with:
# docker run --rm caddy:2.11.4-alpine caddy hash-password --plaintext 'your-password'
# Put the resulting bcrypt hash in single quotes in .env so its dollar signs stay literal.
VIDEO2TEXT_WEB_USER=video2text
VIDEO2TEXT_WEB_PASSWORD_HASH=replace-with-caddy-password-hash

# Existing Sub2API backend. The Caddy 8081 listener is published to host loopback only.
VIDEO2TEXT_SUB2API_UPSTREAM=10.0.0.218:8080

# Absolute host paths on the Ubuntu VM's dedicated ext4/XFS data disk.
VIDEO2TEXT_STORAGE_MOUNT=/srv/app-data
VIDEO2TEXT_DATA_DIR=/srv/app-data/video2text
VIDEO2TEXT_CONFIG_DIR=/srv/video2text-config

# Browser origin allowed to upload through tusd. This value is a regular expression.
VIDEO2TEXT_WEB_ORIGIN_REGEX=https://stt\.151077\.xyz

# Generate both with: openssl rand -hex 32
VIDEO2TEXT_SHARED_SECRET=replace-with-at-least-32-random-characters
VIDEO2TEXT_PROXY_TOKEN=replace-with-a-different-32-character-random-value

VIDEO2TEXT_MAX_UPLOAD_BYTES=5368709120
VIDEO2TEXT_MAX_ACTIVE_JOBS=4
VIDEO2TEXT_UPLOAD_TOKEN_TTL_SECONDS=86400
VIDEO2TEXT_MEDIA_URL_TTL_SECONDS=86400
VIDEO2TEXT_MEDIA_RETENTION_DAYS=7
VIDEO2TEXT_INCOMPLETE_UPLOAD_HOURS=24
VIDEO2TEXT_DISK_HIGH_WATER_PERCENT=80
VIDEO2TEXT_GLADIA_POLL_INTERVAL=8
VIDEO2TEXT_GLADIA_POLL_MAX_ITERS=900

# Use environment variables or JSON files under VIDEO2TEXT_CONFIG_DIR.
# Comma-separated enabled providers (minimax, glm, qwen); empty disables translation.
# Readiness checks only local configuration and writable data, never provider APIs.
VIDEO2TEXT_ENABLED_TRANSLATION_PROVIDERS=minimax
GLADIA_API_KEY=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
GLM_MODEL=glm-5.3-flash
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
