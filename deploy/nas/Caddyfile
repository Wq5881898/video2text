# Official public edge: preserve the deployed STT/upload routing exactly.
# Source: video2text docker-v3 255e512e8e12fd43b0c7066d2cfa672b27543335; only the separate :8081 audit site is omitted.
{
	admin off
	persist_config off
}

{$VIDEO2TEXT_WEB_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

    @control path /api/*
    @jobs path /jobs/*
    @nas path /nas
    @mobile path /mobile
    @cantones path /cantones /cantones/*

    route {
        redir / /nas 302

        handle @cantones {
            reverse_proxy cantones:4178
        }

        handle @control {
            reverse_proxy worker:8080
        }

        handle @jobs {
            root * /srv/video2text-web
            rewrite * /job.html
            file_server
        }

        handle @nas {
            root * /srv/video2text-web
            rewrite * /index.html
            file_server
        }

        handle @mobile {
            root * /srv/video2text-web
            rewrite * /mobile.html
            file_server
        }

        handle {
            root * /srv/video2text-web
            file_server
        }
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Upload-Token delete
                request>headers>X-Video2Text-Proxy-Token delete
                request>headers>X-Video2text-Proxy-Token delete
                request>uri query {
                    delete signature
                }
            }
        }
    }
}

{$VIDEO2TEXT_PUBLIC_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    @uploads path /files /files/*
    handle @uploads {
        reverse_proxy tusd:8080
    }

    @media path /media/*
    handle @media {
        reverse_proxy worker:8080
    }

    @health path /health
    handle @health {
        reverse_proxy worker:8080
    }

    handle {
        respond 404
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Upload-Token delete
                request>headers>X-Video2Text-Proxy-Token delete
                request>headers>X-Video2text-Proxy-Token delete
                request>uri query {
                    delete signature
                }
            }
        }
    }
}
