{$VIDEO2TEXT_WEB_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
    }

    @control path /api/*
    @jobs path /jobs/*
    @nas path /nas
    @mobile path /mobile

    route {
        redir / /nas 302

        handle @control {
            reverse_proxy worker:8080
        }

        handle @jobs {
            root * /srv/video2text-web
            rewrite * /job.html
            file_server
        }

        handle @nas {
            root * /srv/video2text-web
            rewrite * /index.html
            file_server
        }

        handle @mobile {
            root * /srv/video2text-web
            rewrite * /mobile.html
            file_server
        }

        handle {
            root * /srv/video2text-web
            file_server
        }
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Upload-Token delete
                request>headers>X-Video2Text-Proxy-Token delete
                request>headers>X-Video2text-Proxy-Token delete
                request>uri query {
                    delete signature
                }
            }
        }
    }
}

{$VIDEO2TEXT_PUBLIC_HOST} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    @uploads path /files /files/*
    handle @uploads {
        reverse_proxy tusd:8080
    }

    @media path /media/*
    handle @media {
        reverse_proxy worker:8080
    }

    @health path /health
    handle @health {
        reverse_proxy worker:8080
    }

    handle {
        respond 404
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Upload-Token delete
                request>headers>X-Video2Text-Proxy-Token delete
                request>headers>X-Video2text-Proxy-Token delete
                request>uri query {
                    delete signature
                }
            }
        }
    }
}

http://:8081 {
    @sub2api {
        path /v1/* /v1beta/* /backend-api/codex/* /responses /responses/* /models /models/* /chat/completions /messages/count_tokens /alpha/search /embeddings
    }

    handle @sub2api {
        reverse_proxy {$VIDEO2TEXT_SUB2API_UPSTREAM} {
            flush_interval -1
            header_up X-Forwarded-Proto https
            transport http {
                read_timeout 3600s
                write_timeout 3600s
            }
        }
    }

    handle {
        respond 404
    }

    log {
        output stdout
        format filter {
            wrap json
            fields {
                request>headers>X-Upload-Token delete
                request>headers>X-Video2Text-Proxy-Token delete
                request>headers>X-Video2text-Proxy-Token delete
                request>uri query {
                    delete signature
                }
            }
        }
    }
}
